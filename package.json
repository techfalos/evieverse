{
  "name": "theuniverse",
  "version": "0.1.0",
  "description": "Open source social media server: store any content, hashtags, likes, and token-budgeted feeds planned from a per-hashtag index in Redis.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "compact": "node dist/compact/main.js",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.8",
    "mysql2": "^3.24.6",
    "opendal": "^0.49.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
