{
  "name": "evieverse",
  "version": "0.1.0",
  "description": "Open source social media server: image, video, audio, text and link posts, hashtags, likes, and feeds planned from a per-hashtag index in Redis.",
  "license": "See Modified AGPLv3 License in LICENSE.md",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"for(const d of ['db/migrations','challenge/voices'])require('fs').cpSync('src/'+d,'dist/'+d,{recursive:true})\" && node scripts/build-cli.mjs",
    "start": "node dist/server.js",
    "compact": "node dist/compact/main.js",
    "migrate": "node dist/db/migrate.js",
    "admin": "node dist/moderation/admin.js",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-conventions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.8",
    "mysql2": "^3.24.6",
    "opendal": "^0.49.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
