# Evieverse server configuration: every setting, set to its default.
#
# docs/CONFIG.md describes every setting and how to deploy a change.
#
# Copy this file to .env (git-ignored) and change what you need. The server doesn't read .env files itself:
# load one with `node --env-file=.env dist/server.js`, Docker Compose's `env_file:`, or your platform's settings.
#
# Environment variables take precedence over the JSON config file (EVIEVERSE_CONFIG), so a variable set
# here overrides that file even where it only repeats the default.
#
# An empty value counts as unset. Variables left commented out have no fixed default: their comment says
# what leaving them unset does.

# --- Server ---
HOST=0.0.0.0
PORT=3000
# A pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Absolute base URL used for links to images, video and audio in feed records, e.g. https://api.example.com. Empty: relative links.
PUBLIC_BASE_URL=
# Origins whose pages may call the API from a browser, separated by commas or spaces, e.g.
# https://app.example.com,http://localhost:5173, or * for any. Empty: none, so only pages on the API's own origin can.
CORS_ORIGINS=
# The proxies in front of the server whose X-Forwarded-For is believed, for the client address that registrations,
# feeds and the other reads that need no key are limited by (REGISTER_RATE_LIMIT_PER_HOUR, FEED_RATE_LIMIT_PER_MINUTE,
# FEED_FOLLOWING_RATE_LIMIT_PER_MINUTE, CONTENT_RATE_LIMIT_PER_MINUTE, PROFILE_POSTS_RATE_LIMIT_PER_MINUTE, AVATAR_RATE_LIMIT_PER_MINUTE, SPLASH_RATE_LIMIT_PER_MINUTE, COMMENTS_LIST_RATE_LIMIT_PER_MINUTE,
# REPOSTS_ATTESTATION_RATE_LIMIT_PER_MINUTE, TAG_LOG_RATE_LIMIT_PER_MINUTE) and that the audit log and the request log record: a number of
# proxies (1 behind one load balancer), or their addresses or CIDR ranges, separated by commas or spaces. Empty:
# none, so the address is the connection's own. Give a number only where nothing can reach the server except
# through those proxies: anyone connecting directly could choose their own address. A number that is too low
# counts every reader as a proxy, and they then share one address's limits: check `remoteAddress` in the
# request log, which should be the reader's own address.
TRUST_PROXY=
# The language the server answers in when a request asks for none it has, and a user has chosen none: the code
# of one of the files of the languages folder (en for en.json). The server doesn't start if that file isn't there.
DEFAULT_LANGUAGE=en
# The modification disclosure, which GET /rules gives to anyone who asks, beside the server's rules. Evieverse's
# additional license terms (LICENSE.md) have a modified version (one whose source code differs from a release; they say what
# doesn't count) say that it is one, and where its source code can be obtained. Setting these two is the supported
# way: true (or yes, or 1) if this instance runs a modified version, and the http or https address of its source
# code, which the server doesn't start as a modified version without. It is your own statement, which the server
# checks against nothing.
EVIEVERSE_MODIFIED=false
EVIEVERSE_SOURCE_URL=
# The email address people write to for support, which GET /rules gives to anyone who asks, beside the server's
# rules. The default is a placeholder: set it to an address that someone reads. The server sends it nothing, and
# doesn't start if it isn't an email address.
SUPPORT_EMAIL=noreply@yoururl.com
# The youngest a person may be to use the server, in whole years (1 to 120), such as 13, which GET /rules gives
# to anyone who asks, beside the server's rules, as `minimumAge`. Empty or 0: there is none, and GET /rules says
# "All Legal Ages Allowed" instead. It is your own rule: the server asks nobody's age, and holds nobody to it.
# The server doesn't start if it isn't such a number.
MINIMUM_AGE=
# What the server says of content made with generative AI, which GET /rules gives to anyone who asks, beside
# the server's rules, as `genAi`. One of:
#   disclosure_optional  it is allowed, and its author may declare that it was created with AI;
#   disclosure_required  it is allowed, and its author has to declare it;
#   not_allowed          it is not allowed.
# The declaration is the one a post or a comment is sent with (aiGenerated). It is your own rule, and the
# server doesn't hold anyone to it yet: whatever this says, a post or a comment is taken with the declaration
# or without it. The server doesn't start if it is none of the three. Empty: disclosure_optional.
GEN_AI=disclosure_optional
# What the server does with post titles, which GET /rules gives to anyone who asks, beside the server's
# rules, as `postTitles`. One of:
#   on_required  every post has a title: one sent without is refused;
#   on_optional  a post has a title or not, as its publisher likes;
#   off          posts have no titles: one sent with a title is refused, and none is shown.
# In any case, and with a hyphen in place of the underscore if you like: On-Required, On-Optional, Off.
# A title is one line of plain text, of 200 characters at most. Unlike the rules above, the server holds
# posts to this one (POST /store), new ones and updates. Turning titles off deletes none: the titles posts
# already have are kept, and shown again once titles are back on. The server doesn't start if it is none
# of the three. Empty: on_required.
POST_TITLES=on_required
# JSON file of nested settings (see src/config.ts), read only if it exists.
EVIEVERSE_CONFIG=evieverse.config.json

# --- Database ---
# sqlite, postgres or mysql.
DB_DIALECT=sqlite
# A file path (or :memory:) for sqlite, or a connection URL for postgres or mysql,
# e.g. postgres://evieverse:evieverse@localhost:5432/evieverse.
DATABASE_URL=./data/evieverse.sqlite
DB_POOL_SIZE=10
# Close connections idle this long, in milliseconds (postgres, mysql). Unset: the driver's default.
# DB_IDLE_TIMEOUT_MS=10000
# Bring the schema up to date whenever a process opens the database. false: run `npm run migrate` when you deploy.
DB_MIGRATE_ON_START=true
# true: don't start on a SQLite database that would be lost with the container it is in, which is one in
# memory, or a file that isn't on a mounted volume (Linux only: it reads /proc/self/mountinfo). The Docker
# image sets it, so `docker run` without `-v <volume>:/app/data` stops with an error instead of losing the
# database with the container. Postgres and MySQL keep their data themselves, and aren't checked. Unset: off.
# DB_REQUIRE_VOLUME=true
# Read by the server (dist/server.js) only: the first time it starts, on a database with no admin, it creates
# one, named "admin", and writes its profile for the CLI to this file, API key included, for its owner alone
# to read. Copied to ~/.evieverse/profiles/<name>.json, it signs the CLI in as the admin. The Docker image
# sets it to /app/data/admin-profile.json. Unset: the server creates no account.
# FIRST_ADMIN_PROFILE=./data/admin-profile.json
# Read by `npm run migrate` and the migrate function only, not by the server: an admin account for them to
# set up after the migrations, as JSON. keyHash is the SHA-256 (hex) of an API key in the server's format,
# ev_<12 hex>_<43 base64url characters>; the key itself isn't given.
# The account is created if it's new, made an admin, and left with that key alone, if the key is new to it.
# A key the account had and replaced since (POST /users/:userId/key) stays revoked. Unset: nothing is set up.
# BOOTSTRAP_ADMIN='{"userId":"<a UUID>","username":"admin","keyHash":"<64 hex>"}'

# --- Redis: feed index, hot summaries, comments, publisher credits and challenges ---
# redis:// or rediss:// URL of any Redis-protocol server (Redis, Valkey), not in cluster mode, running a
# volatile-* eviction policy (volatile-lru). Required: every process of a deployment is given the same one,
# and none starts without it. `docker compose up -d redis` starts one on this port for development.
REDIS_URL=redis://localhost:6379
# Put in front of every key, so instances can share a Redis. It was tu: before: a deployment that had it unset
# keeps the index it has by setting REDIS_KEY_PREFIX=tu:, or fills the new one with a rebuild
# (`npm run compact -- --rebuild --once`).
REDIS_KEY_PREFIX=ev:

# --- Content store: each content's bytes and its metadata file ---
# Any Apache OpenDAL scheme (fs, s3, gcs, azblob, sftp, webdav, ...), with its options as a JSON object.
CONTENT_SCHEME=fs
CONTENT_OPTIONS='{"root":"./data/content"}'
# Lifetime of the presigned links to stored bytes, and of the upload links POST /uploads gives, in seconds.
CONTENT_SIGNED_URL_SECONDS=900

# --- Summary store: Brotli-compressed summaries for the whole retention period ---
# Same format as CONTENT_SCHEME and CONTENT_OPTIONS. Unset: the content store, under summaries/.
# SUMMARY_SCHEME=s3
# SUMMARY_OPTIONS='{"bucket":"tu-summaries","region":"us-east-1"}'
# Summaries of posts younger than this many days are also kept in Redis; older ones are read from the summary store.
SUMMARY_HOT_DAYS=8
# Brotli quality (0-11) of stored summaries.
SUMMARY_BROTLI_QUALITY=11
# Summaries read from the summary store that each node keeps in memory.
SUMMARY_CACHE_SIZE=20000
# ...and for how many seconds. A post older than SUMMARY_HOT_DAYS can show as it was before an update for this
# long (0: not kept in memory).
SUMMARY_CACHE_SECONDS=60

# --- Audit log: every change, whole, for cold storage ---
# Every request that adds, updates or deletes something (a POST, PUT, PATCH or DELETE the server answered as done) is
# written as one gzipped JSON object: the request's whole body (API keys left out), who sent it, and the ids the
# response named. Reads, such as /feed, never are. Same format as CONTENT_SCHEME and CONTENT_OPTIONS: point it at a
# bucket of its own, and have the bucket move objects to cold storage. Unset: nothing is written.
# AUDIT_SCHEME=s3
# AUDIT_OPTIONS='{"bucket":"tu-audit","region":"us-east-1"}'

# --- Uploads ---
# Largest image, video or audio file accepted, in bytes (5 GiB): a post's, or the image or video of a comment.
MAX_UPLOAD_BYTES=5368709120
# Where uploads are spooled while they arrive. Unset: evieverse/ in the OS temp directory.
# STORAGE_TMP_PATH=/var/tmp/evieverse
# Upload links (POST /uploads) a user can ask for in a minute. Each lets them put one file in the content store,
# where it stays until it's posted or the store expires it. Shared by all nodes (0: no limit).
UPLOAD_LINKS_PER_MINUTE=10

# --- Hashtags ---
# Which hashtags a post can have. Its publisher chooses them, up to 10, and every post must have some.
# user: any hashtags. server: only those of TAGGING_SERVER_TAGS; a post sent with any other is refused.
TAGGING_MODE=user
# The hashtags posts can have in server mode, as many as you like, separated by commas or spaces,
# e.g. news,local,sports. Required in server mode. GET /tagging lists them, for clients to offer.
TAGGING_SERVER_TAGS=
# In user mode, a user can claim a hashtag that has no moderator (POST /tags/:tag/claim), and moderates it from
# then on. Every admin and server moderator is told, by a notice in their inbox, and any of them can end it at
# any time (DELETE /tags/:tag/moderators/:userId), and bar the user from claiming hashtags (PUT /claim-barred/:userId).
# This is how many hashtags one user can claim in a day. Shared by all nodes (0: no limit).
TAG_CLAIMS_PER_DAY=2
# A hashtag's moderator who does nothing as one on it for this many days is no longer its moderator, and is told
# by a notice in their inbox: approving or removing the hashtag on a post, muting or unmuting a user on it,
# changing its blocked words or its rules, appointing or removing a moderator of it. Counted for each hashtag by
# itself, from when they became its moderator, and for every moderator there was before the server counted, from
# when it started to. A hashtag left with no moderator can be claimed again. Admins and server moderators, who
# moderate every hashtag, are not counted. Shared by all nodes (0: never).
TAG_MODERATOR_INACTIVE_DAYS=365
# Requests to GET /tags/:tag/log from one address in a minute, past which they get 429. A hashtag's log is what
# moderators did to the posts under it, which anyone reads with no key, a page at a time, from the database.
# Counted as feeds are (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
TAG_LOG_RATE_LIMIT_PER_MINUTE=120

# --- Post types ---
# Which types of post the server takes: all five by default. false turns one off, and at least one must stay on:
# a server of pictures alone sets every one but POST_TYPE_IMAGE to false.
# A type that's off takes no new post and no update of one (400), and POST /uploads gives no link for its files.
# Posts of it the server already holds stay, to read, like and delete.
# A comment comes with an image or a video only where posts of that type are taken. Its text is no text post,
# so comments are written whether POST_TYPE_TEXT is on or off.
POST_TYPE_TEXT=true
POST_TYPE_IMAGE=true
POST_TYPE_VIDEO=true
POST_TYPE_AUDIO=true
POST_TYPE_LINK=true

# --- Videos ---
# Whether the server processes the videos it is sent: a video post's, and the one a comment comes with.
# true: a video is not published as it was sent. It is made an MP4 of H.264 and AAC, which plays on any device,
# without the metadata its file came with (where and when it was filmed, on what), and a post's also gets a
# poster image and an adaptive stream (HLS) at several sizes, so a slow connection plays a small one. The post,
# or the comment, is published once that is done, and says "processing" until then.
# The work is done with ffmpeg by the compactor's process (npm run compact): it needs ffmpeg and ffprobe, which
# the Docker image has, and refuses to start without them. It is CPU work: give that process at least 2 CPUs
# and 2 GB where videos are common.
# false: videos are stored and served as they are sent, metadata and all, and no ffmpeg is needed.
# Every process of a deployment takes the same value.
VIDEO_PROCESSING=true
# The heights a post's video is made at, in pixels (144 to 2160, up to 8 of them), separated by commas or spaces.
# The ones taller than the video are left out. The MP4 a post is read as is the tallest that is no more than 720.
VIDEO_HEIGHTS=1080,720,480,240
# The most a comment's video measures in height, in pixels. It is one MP4, with no stream and no poster.
VIDEO_COMMENT_HEIGHT=720
# Seconds ffmpeg is given for one video, all of its sizes together, before the video is given up: its publisher
# is told, a new post is deleted, and an update keeps the video the post had. Keep it above what the longest
# video the server takes (MAX_UPLOAD_BYTES) needs on the machine the compactor runs on.
VIDEO_TIMEOUT_SECONDS=3600
# The ffmpeg and ffprobe to run: a path, or a name that is looked for on the PATH.
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_FFPROBE_PATH=ffprobe

# --- Reposts ---
# Whether the server takes reposts (POST /repost): a user gives a post more hashtags, which puts it in those
# hashtags' feeds and in the following feeds of their own followers, as a new post there. The post isn't
# copied. false: POST /repost is refused (400), and what was reposted before stays as it is.
REPOSTS=true
# Whether it also takes reposts of posts on other servers. Such a repost is stored as a link to the original
# with the original's summary, as the original's server signed it (its attestation): the reposter's client
# sends that, and this server asks the other one, over https, only for the keys it signs with and, now and
# then, for the post's attestation again (REPOSTS_REFRESH_HOURS).
# false: only posts on this server are reposted.
REPOSTS_REMOTE=true
# How often, in hours, the server asks the server of each post it holds a repost of for the post's attestation
# again, which is how a repost follows an edit of its original and is hidden once the original is gone. The
# process that runs the compactor asks, over https, at most 30 posts a minute, so it must be able to reach the
# other servers. 0: never, so a repost changes only when a client brings a later attestation (POST /repost/refresh).
REPOSTS_REFRESH_HOURS=24
# Days a repost of a post on another server stays hidden after that server said it publishes no post there,
# before the compactor deletes it. The other server says that of a post it deleted and of one that only waits
# in its moderation queue, so the repost is kept this long for the post to be attested again, which brings it
# back with the hashtags reposts gave it (at least 1).
REPOSTS_GONE_DAYS=7
# Requests to /content/:contentId/attestation from one address in a minute, past which they get 429. It needs
# no key, and signs an answer for any id. Other servers ask it for the posts they hold reposts of, up to 30
# times a minute each, so keep it above that. Counted as feeds are (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
REPOSTS_ATTESTATION_RATE_LIMIT_PER_MINUTE=60
# The keys this server signs the attestations of its own posts with, which is what lets them be reposted on
# other servers. Each is 32 random bytes in base64 or hex (`openssl rand -base64 32`), separated by commas or
# spaces. The first signs; all are published (GET /repost/keys), so to change key, put the new one first and
# take the old one out later. They are secrets: whoever has one signs as this server. It needs PUBLIC_BASE_URL
# too, which is where an attestation says a post is. Empty: the server signs nothing, and its posts are
# reposted only here.
REPOSTS_SIGNING_KEYS=

# --- Dislikes ---
# Whether posts can be disliked (POST and DELETE /dislike). A post's dislikes are a count of their own, from 0,
# beside its likes: a dislike takes no like off, and orders no feed.
# false: POST /dislike is refused (400), and `dislikes` is null wherever a post is read (feeds, GET
# /content/:contentId, profiles, searches), which tells a client not to show dislikes at all.
# true: `dislikes` is the post's count there, 0 for a post nobody dislikes.
# The counts are kept either way: turning it off hides them, and turning it on again shows them as they were.
DISLIKES=false

# --- Feeds ---
# Posts per /feed page when the request doesn't pass ?limit=.
FEED_PAGE_SIZE=50
# The largest ?limit= a request may pass.
FEED_MAX_PAGE_SIZE=100
# Requests to /feed from one address in a minute, past which they get 429. A feed needs no key, so the address
# is all there is to count by; an IPv6 address counts with the rest of its /64. Shared by all nodes (0: no
# limit). Behind a load balancer, also set TRUST_PROXY, or every reader counts as the proxy and shares one limit.
FEED_RATE_LIMIT_PER_MINUTE=120
# The same for /feed/following, counted apart: a page of it asks the database who may read it and reads the
# index of every user followed, which a hashtag feed doesn't (0: no limit).
FEED_FOLLOWING_RATE_LIMIT_PER_MINUTE=60
# /feed requests one process answers at a time. One that arrives while this many are under way gets 503, with
# Retry-After, rather than waiting behind them: this is what holds when a flood comes from many addresses
# (0: no limit).
FEED_MAX_CONCURRENT=100
# Posts a hashtag's index keeps for today. Each older UTC day keeps half the previous day's, down to the minimum.
FEED_TAG_DAY_MAX_POSTS=400
FEED_TAG_DAY_MIN_POSTS=40
# UTC days a hashtag's index keeps, and summaries are stored (capped at FEED_MAX_LOOKBACK_DAYS).
FEED_TAG_RETENTION_DAYS=90
# Posts each publisher's own index, which following feeds read, keeps per UTC day: the newest, whatever their likes.
FEED_AUTHOR_DAY_MAX_POSTS=1000
# How far back, in days, a following feed reaches, and the longest a hashtag's index is kept (at least 7).
# A hashtag feed is of the window it asks for (?hours=), which this doesn't change.
FEED_MAX_LOOKBACK_DAYS=90
# Words of a text post or caption copied into each record's preview, and at most how many characters of them
# (which is what ends most previews, and all of a text written without spaces).
FEED_PREVIEW_WORDS=100
FEED_PREVIEW_CHARS=160
# In an engaged feed (?algorithm=engaged), one in this many picks per hashtag is new low-like content (0 disables).
# A popular feed has none: it is in the order of its likes.
FEED_FRESH_EVERY=4
# Records with at most this many likes count as fresh.
FEED_FRESH_MAX_LIKES=0
# Fresh picks are sampled per feed session from this many newest eligible records per hashtag in the feed's window.
FEED_FRESH_POOL=200
# A feed asked to add related hashtags (?addRelated=true) adds at most this many for each hashtag asked for,
# its most related first (0 turns related hashtags off).
FEED_RELATED_TAGS=3
# A hashtag is related to another once at least this many posts carry both...
FEED_RELATED_MIN_POSTS=5
# ...and those are at least this percent of the posts that carry the other.
FEED_RELATED_MIN_PERCENT=20
# How long each node caches a hashtag's head, its related hashtags and publisher credits.
# The index keys a compactor run replaces are kept this long and a minute.
FEED_HEAD_CACHE_MS=1000
# Hashtags whose manifest and day indexes each node keeps in memory.
FEED_INDEX_CACHE_SIZE=500
# The same for publishers' own indexes, which following feeds read: one per user followed.
FEED_AUTHOR_CACHE_SIZE=5000

# --- Following ---
# The most users one user can follow. A following feed reads the index of every one of them.
MAX_FOLLOWING=1000

# --- Inbox ---
# Messages a user can send other users (POST /messages) in a minute. Shared by all nodes (0: no limit).
INBOX_MESSAGES_PER_MINUTE=10
# Days a message or a moderation notice stays in a user's inbox, read or not. The compactor deletes older ones, once a day.
INBOX_RETENTION_DAYS=90

# --- Data export ---
# A user reads everything the server holds of them a page at a time (GET /users/:userId/export): each page is
# up to 1,000 records and about a megabyte, and comes with the cursor of the next. Pages one user can read in
# a minute, past which they get 429. Shared by all nodes (0: no limit).
EXPORT_PAGES_PER_MINUTE=120

# --- Search ---
# GET /search finds users by the start of their username, and posts by the words of their text or caption and
# by their hashtags. Requests to it from one address in a minute, past which they get 429. It needs no key and
# reads the database. Counted as feeds are (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
SEARCH_RATE_LIMIT_PER_MINUTE=60
# The most words of its text or caption a post is found by: the most frequent ones, beside every one of its
# hashtags. The compactor keeps them, as it writes the post. After a change, `npm run reindex` applies it to
# the posts that are already there.
SEARCH_MAX_KEYWORDS=100

# --- Comments ---
# Comments are limited as posts are (see POST_RATE_LIMIT_PER_MINUTE below), by a setting of their own.
# A user's comments (POST /content/:contentId/comments) past this many in any minute, on any posts, get 429.
# Edits of comments count, and only the ones that are published or held do.
# Shared by all nodes (0: no limit).
COMMENTS_PER_MINUTE=10
# Requests from one address in a minute to each of the two lists of comments (a post's comments, and the replies
# to a comment), past which they get 429. They need no key, and a list of a post whose comments Redis doesn't
# hold is a listing of the content store. Counted as feeds are (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
COMMENTS_LIST_RATE_LIMIT_PER_MINUTE=120
# Comments are objects in the content store, and Redis keeps a copy of each one written or read, and each
# post's index of its comments, for this many hours (at least 1). After that, a post's comments are listed
# from the content store again the next time they're asked for.
COMMENTS_HOT_HOURS=24

# --- Monetization: ads ---
# Admins keep the server's ads (/monetization/ads): text or an image, on a schedule, shown all the time or
# only under the hashtags an ad is targeted at. Every ad comes with the word "Sponsored". Both settings are
# off by default, and a server with both off shows no ad. Give the compactor the same settings as the API:
# it publishes the ads to Redis, where they're read, only where one of them is on.
# true: each page of a hashtag feed (GET /feed) comes with ads to show before its 3rd, 10th and 17th post.
MONETIZATION_FEED_ADS=false
# true: a post (GET /content/:contentId) comes with an ad to show at its end.
MONETIZATION_POST_ADS=false

# --- Compactor ---
# The compactor is a program of its own, beside the server (`npm run compact`, or the binary itself): one
# process that keeps running, however many servers there are, with the same settings as they have. The Docker
# image runs it with the server. Nothing a request writes reaches the stores or the feeds without it.
# A run starts this many seconds after the previous one started, or as soon as that one ends if it took
# longer. So runs never overlap, and there's never more than one in this many seconds. A run is what writes
# posts and comments to the stores, and puts new posts, likes, moderators' decisions and deletions in feeds
# and new comments in the lists of comments, so this is how long they wait at most.
COMPACT_INTERVAL_SECONDS=5
# Related-hashtag counts are read once they're this old, which covers clock skew between nodes.
COMPACT_GRACE_SECONDS=30
# Batches of indexes compacted in parallel. A batch is 200 hashtags' or publishers' indexes, read and
# written together.
COMPACT_CONCURRENCY=4
# Writes to comments a run has under way at once, on whatever posts: a comment's own write, or one like of it.
# Beside them, a run writes the posts of COMPACT_CONCURRENCY posts at a time.
COMPACT_COMMENT_WRITES=16
# Lifetime of the database lease that keeps the runs of two compactor processes from overlapping (a deploy
# replacing one, a rebuild started by hand), at least 30. A process that stops without releasing it delays the
# next run by up to this long.
COMPACT_LEASE_SECONDS=60

# --- Challenges and rate limits ---
# /register always needs a challenge, except from an admin: no setting turns that off. Nothing else
# needs one: posts and comments are held to a limit a minute (POST_RATE_LIMIT_PER_MINUTE below, and
# COMMENTS_PER_MINUTE above).
# How long a challenge can be solved for.
CHALLENGE_TTL_SECONDS=120
# Proof-of-work difficulty (0-32): each bit doubles the client's work (0: none).
CHALLENGE_POW_BITS=18
# Answers sent sooner than this after the challenge was issued are refused.
CHALLENGE_MIN_SOLVE_MS=2000
# Requests to /register from one address in an hour, past which they get 429. Every attempt counts, an
# admin's included, so registering uses two. Shared by all nodes. Behind a load balancer, also set
# TRUST_PROXY, or every client counts as the proxy.
REGISTER_RATE_LIMIT_PER_HOUR=10
# Requests to /content/:contentId from one address in a minute, past which they get 429. A post is read with
# no key, from the database and the content store. Counted as feeds are (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
CONTENT_RATE_LIMIT_PER_MINUTE=300
# Requests to /users/:userId/posts from one address in a minute, past which they get 429. A user's posts are
# listed for their profile with no key, from the database, the summary store and the content store. Counted as
# feeds are (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
PROFILE_POSTS_RATE_LIMIT_PER_MINUTE=120
# Requests to /users/:userId/avatar from one address in a minute, past which they get 429. An avatar is read
# with no key, from the database and the content store. Counted as feeds are (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
AVATAR_RATE_LIMIT_PER_MINUTE=300
# Requests to /users/:userId/splash from one address in a minute, past which they get 429. A profile's splash
# image is read with no key, from the database and the content store. Counted as feeds are
# (FEED_RATE_LIMIT_PER_MINUTE; 0: no limit).
SPLASH_RATE_LIMIT_PER_MINUTE=120
# A user's posts (/store) past this many in any minute get 429. Reposts and updates of posts count,
# and only the ones that are stored do. Shared by all nodes (0: no limit).
POST_RATE_LIMIT_PER_MINUTE=3
# Posts and comments a user can report (POST /report) in an hour. Each puts a post or a comment in the report
# queue, which server moderators and admins work through. Shared by all nodes (0: no limit).
REPORTS_PER_HOUR=20

# --- Trust score: where a post goes ---
# Every post and update gets a trust score from 0 (not trusted at all) to 100 when it is sent, and so does
# every comment: what follows applies to a comment as to a post.
# It starts at 100, and each trust plugin (a folder of compactor/crates/trust/src/plugins) the server runs can lower it.
# The server comes with three: blocked_words, which gives a post with one of the server's blocked words 0,
# and urlhaus and pdq, which are optional (see TRUST_OPTIONAL_PLUGINS below).
# The score isn't kept, except beside a post that waits in the moderation queue.
# A post that scores less than this is deleted on arrival: refused with 422, and nothing of it is kept.
# 0: no post is, so posts with a blocked word wait in the moderation queue instead.
TRUST_SCORE_DELETE_BELOW=25
# A post that scores at least this is published. One that scores less, and isn't deleted, waits in
# the moderation queue until an admin accepts or rejects it. 101: every post waits.
# Can't be less than TRUST_SCORE_DELETE_BELOW.
TRUST_SCORE_ALLOW_FROM=75
# The optional trust plugins the server runs, by the names of their folders in compactor/crates/trust/src/plugins,
# separated by commas or spaces. A plugin is optional if it says so (its `optional` returns true),
# and then runs only on a server that names it here: any other plugin runs on every server.
# The server comes with two optional plugins, urlhaus and pdq (below). Empty: no optional plugin runs.
# A name that isn't one of the plugins the server was built with stops the server and the compactor from starting.
TRUST_OPTIONAL_PLUGINS=

# --- Links that spread malware (the urlhaus trust plugin, which is optional) ---
# Turned on with TRUST_OPTIONAL_PLUGINS=urlhaus, which then needs URLHAUS_AUTH_KEY. Off, links aren't
# checked and what follows isn't read.
# A post or a comment with a link that is on URLhaus's list of malware URLs (https://urlhaus.abuse.ch)
# gets a trust score of 0. Every link is checked: a link post's URL, and the links written in a text, a
# caption or a comment. The server never follows a link: each process downloads the list, keeps it in
# memory and looks links up there, so it must be able to reach urlhaus-api.abuse.ch.
# The Auth-Key of an abuse.ch account, which is free (https://auth.abuse.ch). A server that turns the
# plugin on without one doesn't start.
# While a process has no list because its first download failed, posts with a link get 500.
URLHAUS_AUTH_KEY=
# Where the list is downloaded from, with {key} where the Auth-Key goes: one of URLhaus's database
# dumps as a CSV, or its plain list of URLs (https://urlhaus.abuse.ch/api/). This one has the URLs
# added in the last 30 days.
URLHAUS_LIST_URL=https://urlhaus-api.abuse.ch/v2/files/exports/{key}/recent.csv
# Minutes between two downloads of the list, by each process. URLhaus writes its lists every 5 minutes
# and asks not to be asked more often, so 5 is the least.
URLHAUS_REFRESH_MINUTES=15

# --- Images and videos of known child sexual abuse material (the pdq trust plugin, which is optional) ---
# Turned on with TRUST_OPTIONAL_PLUGINS=pdq, which then needs PDQ_HASH_LIST. Off, images and videos
# aren't checked and what follows isn't read.
# Every image of an image post, and the image a comment comes with, is hashed with PDQ (Meta's
# perceptual hash: a copy that was resized, compressed again or lightly edited has nearly the same
# hash), and the hash is looked up in a list of hashes of known material. A post or a comment with
# an image that matches gets a trust score of 0: it is refused (422, and whoever sent it isn't told
# why), or waits in the moderation queue if TRUST_SCORE_DELETE_BELOW=0. Every admin then gets a
# notice in their inbox, and the log a warning, with who sent it, when, from which address, and the
# hashes: what a report to the authorities is written from. The server reports nothing itself, and
# sends no image and no hash anywhere: reporting is the operator's to do, as the law where they
# operate asks (in the United States, to NCMEC's CyberTipline).
# A video is checked where the server processes videos (VIDEO_PROCESSING=true), by the process that
# does: a picture of it every two seconds is hashed and looked up the same way, as Meta's vPDQ does,
# before anything of the video is published. One that matches is refused whatever
# TRUST_SCORE_DELETE_BELOW says: a new post is deleted, an update leaves the post the video it had,
# a comment isn't published, whoever sent it is told only that the video wasn't trusted, and the
# admins are told as of an image. Every process of a deployment takes the same TRUST_OPTIONAL_PLUGINS
# and PDQ_ settings: the one that runs the compactor checks the videos.
# With VIDEO_PROCESSING=false videos are published as they are sent, unchecked.
# Not seen: audio, an image or a video that was mirrored, rotated or cropped far, the frames of an
# animation past its 32nd, what a video shows for less than two seconds between two of the pictures
# that are checked, an ad's image, and reposts of posts on other servers.
# The file that matched is kept only where the server has a quarantine (QUARANTINE_SCHEME, below):
# without one nothing of it is, and there is then no file to send with a report or to preserve after it.
# Where the list is: the path of a file, or an http(s) address it is downloaded from. One PDQ hash a
# line, as 64 hex digits; a CSV or TSV with the hash in a column is read too, and lines that start
# with # are skipped. The server comes with no list, and there is no public one: the hashes are
# shared with the platforms that apply for them by those who keep them (a hash-sharing programme,
# such as NCMEC's or Meta's ThreatExchange). A server that turns the plugin on without one doesn't start.
# Each process reads the list and keeps it in memory, about 100 bytes a hash. While a process has
# no list because its first reading failed, posts and comments with an image get 500.
PDQ_HASH_LIST=
# The Authorization header a list at an address is asked for with, such as "Bearer <token>".
PDQ_HASH_LIST_AUTHORIZATION=
# The most bits, of a hash's 256, an image's hash can differ from a listed one in and still match.
# 31 is what PDQ's authors match at. Lower finds fewer altered copies; higher takes more pictures
# for ones they aren't. 0 to 63.
PDQ_MAX_DISTANCE=31
# The least quality, from 0 to 100, an image's hash must have to be matched: how much there is in
# the picture to tell it by. A picture of one colour has a hash near every other such picture's.
PDQ_MIN_QUALITY=50
# Minutes between two readings of the list, by each process. A file that hasn't changed isn't read again.
PDQ_REFRESH_MINUTES=60

# --- Quarantine: the files that matched, kept for the report and after it ---
# Unset: off, and nothing of a file that matches the pdq plugin's list is kept. Set: the file is written here
# before it is refused (or held in the moderation queue): an image as the server read it, which is without the
# metadata its file came with, and a video as it was sent. Same format as CONTENT_SCHEME and CONTENT_OPTIONS,
# and a store of its own: the server doesn't start if it is the store of the posts, the summaries or the audit log.
# Nothing serves these files but GET /moderation/quarantine/:quarantineId/file, to an admin, as bytes to save:
# there are no links to them. Every time one is kept, read, reported or deleted is recorded in the database
# (the quarantine_access table), with who did it and from which address, and stays there after the file is gone.
# An admin records the report they made of a file (POST /moderation/quarantine/:quarantineId/report). The
# compactor deletes the file QUARANTINE_RETENTION_DAYS after the time of that report, and a file no report
# was recorded of is never deleted by the server: an admin deletes one that is not what the list took it for
# (DELETE /moderation/quarantine/:quarantineId), and the log says once a day how many wait for a report.
# Locking the store down is the operator's to do, and the server can't check it. A bucket nothing else uses,
# private, encrypted, with its access logged, that only the server's own roles can reach: the processes that
# serve the API write and read it, and the one that runs the compactor writes (videos) and deletes. No
# lifecycle rule that deletes: the server deletes what is due, and a rule would delete what isn't.
# In the United States a report to the CyberTipline is a request to preserve what was reported for a year
# (18 U.S.C. 2258A(h)), which is what the default keeps. Other countries ask for other things, and some for
# deletion: check what the law where you operate asks of you. Every process takes the same values.
# QUARANTINE_SCHEME=s3
# QUARANTINE_OPTIONS='{"bucket":"ev-quarantine","region":"us-east-1"}'
# Days a file is kept after the report of it, at least 1. Raising it keeps the files there are longer too.
QUARANTINE_RETENTION_DAYS=365

# --- Functions: one route group per function (dist/functions/lambda.js, dist/functions/http.js) ---
# These two are read by the function entry points only. Functions also default to DB_MIGRATE_ON_START=false,
# DB_POOL_SIZE=2 and DB_IDLE_TIMEOUT_MS=10000 where those are unset, and need REDIS_URL.
# What this function is: feed, content, store or api (a route group). On AWS Lambda also migrate, which
# brings the database schema up to date. The compactor isn't a function: it runs as its own process.
# FUNCTION_GROUP=feed
# A secret the CDN in front of the functions sends as X-Origin-Secret. Requests without it get 403 (except /health).
# Set it where the functions' own addresses are public. Unset: no check.
# FUNCTION_EDGE_SECRET=
